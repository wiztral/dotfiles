export ZSH="$HOME/.oh-my-zsh"
# Prompt comes from oh-my-posh (see below)
ZSH_THEME=""
plugins=(git)
source $ZSH/oh-my-zsh.sh

export PATH="$HOME/bin:$HOME/quick-cmds:$PATH"
export EDITOR=nvim

{{ if eq .osId "wsl-ubuntu" -}}
# Easy ssh on WSL
export GIT_SSH_COMMAND=ssh.exe
alias ssh="ssh.exe"

# keep current path when duplicating windows terminal tab
keep_current_path() {
  printf "\e]9;9;%s\e\\" "$(wslpath -w "$PWD")"
}
precmd_functions+=(keep_current_path)
{{- end }}

# brew
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# fnm
eval "$(fnm env --use-on-cd --shell zsh --version-file-strategy recursive)"

# fzf
eval "$(fzf --zsh)"

# oh-my-posh
eval "$(oh-my-posh init zsh --config ~/.config/ohmyposh/base.toml)"

# Aliases
alias pn=pnpm
alias pnpx="pnpm dlx"

# pyenv
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
fi
