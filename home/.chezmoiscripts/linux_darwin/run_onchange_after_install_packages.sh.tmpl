#!/bin/bash
set -euo pipefail

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
{{ range .packages.brews_linux -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF

# Mason installs language servers with npm on the first nvim launch. Without a
# Node here, WSL falls back to the Windows npm on PATH, whose writes into the
# Linux filesystem end up owned by root.
fnm install --lts
fnm default lts-latest
