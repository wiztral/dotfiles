#!/bin/bash
set -euo pipefail

# System prerequisites (compiler, curl, git) are installed by install.sh.
if [ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ] || [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  echo "Homebrew already installed, skipping."
  exit 0
fi

# Install Homebrew (runs once; re-run manually via brew itself to upgrade)
NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
