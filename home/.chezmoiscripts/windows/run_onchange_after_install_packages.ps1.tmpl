Set-StrictMode -Version 3.0
$ErrorActionPreference = "Stop"

{{ template "refreshenv.ps1" . }}

Update-SessionEnvironment
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    $env:PATH = "$env:PATH;$HOME\scoop\shims"
}

scoop install
{{- range .packages.scoops }} `
{{ . -}}
{{ end }}
if ($LASTEXITCODE -ne 0) { throw "scoop install failed with exit code $LASTEXITCODE" }

{{- range .packages.wingets }}
winget install --id {{ . }} --silent --accept-source-agreements --accept-package-agreements
if ($LASTEXITCODE -ne 0) { throw "winget install --id {{ . }} failed with exit code $LASTEXITCODE" }
{{- end }}

# Mason installs language servers with npm on the first nvim launch.
fnm install --lts
if ($LASTEXITCODE -ne 0) { throw "fnm install --lts failed with exit code $LASTEXITCODE" }
fnm default lts-latest
if ($LASTEXITCODE -ne 0) { throw "fnm default lts-latest failed with exit code $LASTEXITCODE" }
